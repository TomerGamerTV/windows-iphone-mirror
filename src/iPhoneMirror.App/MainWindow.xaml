<Window x:Class="iPhoneMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:iPhoneMirror.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="iPhone Mirror"
        Width="410" Height="880" MinWidth="340" MinHeight="600"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <!-- Larger CornerRadius ≈ macOS iPhone Mirroring window; custom Win11-style caption buttons (right). -->
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="8"
                            GlassFrameThickness="1" CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Phone viewer: edge-to-edge, transparent (no black border). Native DWM rounding clips the MPV HWND cleanly. -->
        <Border Grid.Row="0" x:Name="ViewerFrame" CornerRadius="16" ClipToBounds="True"
                Background="Transparent" BorderThickness="0" Margin="0"
                PreviewMouseLeftButtonDown="ViewerFrame_PreviewMouseDown"
                AutomationProperties.Name="iPhone screen viewer">
            <Grid>
                <!-- Collapsed at idle: an HWND always renders above WPF siblings, so the host must stay hidden until a session needs it, or the empty-state UI stays invisible behind it. -->
                <local:MpvHostControl x:Name="MpvHost" Visibility="Collapsed" AutomationProperties.Name="Mirrored iPhone screen" />
                <Border x:Name="EmptyOverlay" Background="Transparent" Visibility="Visible"
                        AutomationProperties.Name="Viewer status">
                    <Grid>
                        <!-- Settings left; Windows-style caption buttons (min/max/close) right. -->
                        <Grid VerticalAlignment="Top" Height="40">
                            <Button x:Name="SettingsCogButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                    ToolTip="Settings" Click="SettingsButton_Click"
                                    Background="Transparent" BorderThickness="0" FontSize="16"
                                    Foreground="{DynamicResource TextBrush}" Content="⚙"
                                    AutomationProperties.Name="Open settings"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                <Button x:Name="MinBtn" Width="46" Height="40" Style="{StaticResource CaptionButton}"
                                        ToolTip="Minimize" Click="MinBtn_Click" AutomationProperties.Name="Minimize"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <TextBlock Text="—" FontFamily="Segoe UI" FontSize="16" FontWeight="Light"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                </Button>
                                <Button x:Name="MaxBtn" Width="46" Height="40" Style="{StaticResource CaptionButton}"
                                        ToolTip="Maximize" Click="MaxBtn_Click" AutomationProperties.Name="Maximize"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <TextBlock Text="☐" FontFamily="Segoe UI" FontSize="14"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                </Button>
                                <Button x:Name="CloseBtn" Width="46" Height="40" Style="{StaticResource CaptionButton}"
                                        ToolTip="Close" Click="CloseBtn_Click" AutomationProperties.Name="Close"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <TextBlock Text="✕" FontFamily="Segoe UI" FontSize="14"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330" Margin="0,20,0,0">
                            <Border Width="56" Height="96" CornerRadius="12" BorderThickness="3"
                                    BorderBrush="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,18">
                                <Border Width="20" Height="5" CornerRadius="3" Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{DynamicResource MutedTextBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="240"
                                           AutomationProperties.Name="Connection status" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <TextBlock Text="Connect an iPhone" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock x:Name="EmptyMessage" Margin="0,8,0,12" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Use USB for first-time setup. Wi-Fi requires a saved CoreDevice pairing."
                                       AutomationProperties.Name="Viewer message" AutomationProperties.LiveSetting="Polite" />
                            <Border Background="{DynamicResource SheetBrush}" CornerRadius="14" Padding="12">
                                <StackPanel>
                                    <ComboBox x:Name="ConnectionModeBox" SelectionChanged="ConnectionModeBox_SelectionChanged"
                                              AutomationProperties.Name="Connection mode" Margin="0,0,0,6">
                                        <ComboBoxItem Content="Auto" Tag="auto" IsSelected="True" />
                                        <ComboBoxItem Content="USB" Tag="usb" />
                                        <ComboBoxItem Content="Wi-Fi" Tag="wifi" />
                                    </ComboBox>
                                    <ComboBox x:Name="DeviceBox" AutomationProperties.Name="iPhone device" Margin="0,0,0,6">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding DisplayDetails}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid x:Name="WifiFieldsGrid" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="WifiAddressBox" Text="" ToolTip="Wi-Fi iPhone address" AutomationProperties.Name="Wi-Fi iPhone address" Margin="0,0,6,0" />
                                        <TextBox x:Name="WifiPortBox" Grid.Column="1" Text="49152" ToolTip="Wi-Fi remote pairing port" AutomationProperties.Name="Wi-Fi remote pairing port" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click"
                                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                                Padding="22,8" FontSize="14" FontWeight="SemiBold"
                                                AutomationProperties.Name="Connect iPhone" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <Button Content="Setup" Click="SetupButton_Click" Padding="12,6" AutomationProperties.Name="Open phone setup" />
                                        <Button Content="Settings" Click="SettingsButton_Click" Padding="12,6" AutomationProperties.Name="Open settings" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="DeviceStatusText" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="No active session" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                                       AutomationProperties.Name="Device session status" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Content="Reconnect" Click="ReconnectButton_Click" Padding="12,6" AutomationProperties.Name="Reconnect iPhone" />
                                <Button Content="Disconnect" Click="DisconnectButton_Click" Padding="12,6" AutomationProperties.Name="Disconnect iPhone" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom sheet: docked (not overlay) so it never fights the MPV HWND. Opaque SheetBrush fixes white-on-white. -->
        <Border x:Name="SettingsSheet" Grid.Row="1" MaxHeight="560" Margin="8,8,8,8" Padding="0"
                Background="{DynamicResource SheetBrush}" CornerRadius="24" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Grabber: drag down to dismiss -->
                <Border x:Name="SheetGrabber" Grid.Row="0" Background="Transparent" Padding="0,10,0,6"
                        Cursor="SizeNS" ToolTip="Drag down to close"
                        MouseLeftButtonDown="SheetGrabber_Down" MouseMove="SheetGrabber_Move" MouseLeftButtonUp="SheetGrabber_Up">
                    <Rectangle Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="#FF8E8E93" HorizontalAlignment="Center" />
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10" LastChildFill="False">
                            <TextBlock x:Name="PanelTitle" Text="Settings &amp; Options" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <Button Content="Done" Click="CloseSetupButton_Click" DockPanel.Dock="Right" Background="{DynamicResource AccentBrush}" AutomationProperties.Name="Close settings" />
                        </DockPanel>

                        <!-- Tab switcher: segmented, opaque, readable -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TabPhoneSetupBtn" Content="Preferences" Click="TabPhoneSetup_Click" Background="{DynamicResource AccentBrush}" Grid.Column="0" Margin="0,0,2,0" />
                            <Button x:Name="TabSettingsBtn" Content="Phone Setup" Click="TabSettings_Click" Background="{DynamicResource SegmentBrush}" Foreground="{DynamicResource SegmentTextBrush}" Grid.Column="1" Margin="2,0,0,0" />
                        </Grid>

                        <!-- Preferences Tab View -->
                        <StackPanel x:Name="PhoneSetupSection" Visibility="Visible">
                            <TextBlock Text="PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,6" />
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="HwDecodeBox" Content="GPU Hardware Acceleration" IsChecked="True"
                                              Foreground="{DynamicResource TextBrush}"
                                              Checked="HwDecode_Changed" Unchecked="HwDecode_Changed" AutomationProperties.Name="Hardware acceleration" />
                                    <TextBlock Text="Fastest decode for lowest mirroring latency."
                                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="20,2,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="WINDOW &amp; BACKDROP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,6" />
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="AlwaysOnTopBox" Content="Keep Always on Top"
                                              Foreground="{DynamicResource TextBrush}"
                                              Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed" AutomationProperties.Name="Always on top" />
                                    <TextBlock Text="Float iPhone over other windows." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="20,2,0,8" TextWrapping="Wrap" />

                                    <TextBlock Text="Backdrop Effect (Windows 11):" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,2,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BackdropAcrylicBtn" Grid.Column="0" Content="Acrylic" Click="BackdropAcrylic_Click" Margin="0,0,3,0" AutomationProperties.Name="Acrylic backdrop" />
                                        <Button x:Name="BackdropMicaBtn" Grid.Column="1" Content="Mica" Click="BackdropMica_Click" Margin="3,0" AutomationProperties.Name="Mica backdrop" />
                                        <Button x:Name="BackdropSolidBtn" Grid.Column="2" Content="Solid" Click="BackdropSolid_Click" Margin="3,0,0,0" AutomationProperties.Name="Solid backdrop" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="PHONE SIZE PRESETS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,6" />
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="75% Small" Click="Scale75_Click" Grid.Column="0" Margin="2,0" Padding="4,6" FontSize="11" AutomationProperties.Name="Scale 75 percent" />
                                    <Button Content="100% Actual" Click="Scale100_Click" Grid.Column="1" Margin="2,0" Padding="4,6" FontSize="11" AutomationProperties.Name="Scale 100 percent" />
                                    <Button Content="125% Large" Click="Scale125_Click" Grid.Column="2" Margin="2,0" Padding="4,6" FontSize="11" AutomationProperties.Name="Scale 125 percent" />
                                </Grid>
                            </Border>

                            <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,6" />
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Ctrl + 1" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Width="70" />
                                        <TextBlock Text="Home Screen" Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Ctrl + 2" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Width="70" />
                                        <TextBlock Text="App Switcher" Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Ctrl + 3" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Width="70" />
                                        <TextBlock Text="Spotlight Search" Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Ctrl + V" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Width="70" />
                                        <TextBlock Text="Paste text to iPhone" Foreground="{DynamicResource TextBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Phone Setup Tab View -->
                        <StackPanel x:Name="SettingsSection" Visibility="Collapsed">
                            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Each action that changes the phone or pairing records asks for confirmation first. Passcodes stay on the iPhone." />
                            <Button Content="Refresh USB devices" Click="RefreshDevicesButton_Click" AutomationProperties.Name="Refresh USB devices" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Check setup" Click="CheckSetupButton_Click" AutomationProperties.Name="Check iPhone setup" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Trust this computer" Click="PairUsbButton_Click" AutomationProperties.Name="Trust this computer" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Reveal Developer Mode" Click="RevealDeveloperModeButton_Click" AutomationProperties.Name="Reveal Developer Mode" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Prepare developer image" Click="PrepareImageButton_Click" AutomationProperties.Name="Prepare developer image" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Pair Wi-Fi" Click="PairWifiButton_Click" AutomationProperties.Name="Pair iPhone for Wi-Fi" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Validate display service" Click="CheckDisplayButton_Click" AutomationProperties.Name="Validate display service" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Reconnect" Click="ReconnectButton_Click" Grid.Column="0" Margin="0,0,3,0" AutomationProperties.Name="Reconnect iPhone" />
                                <Button Content="Disconnect" Click="DisconnectButton_Click" Grid.Column="1" Margin="3,0,0,0" AutomationProperties.Name="Disconnect iPhone" />
                            </Grid>
                            <TextBlock x:Name="SetupStatusText" Margin="4,12,4,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                       AutomationProperties.Name="Setup status" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>

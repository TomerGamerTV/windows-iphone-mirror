<Window x:Class="iPhoneMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:iPhoneMirror.App"
        Title="iPhone Mirror"
        Width="920" Height="820" MinWidth="620" MinHeight="600"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="iPhone Mirror" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{DynamicResource MutedTextBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource MutedTextBrush}"
                                   AutomationProperties.Name="Connection status" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="ConnectionModeBox" Width="105" SelectionChanged="ConnectionModeBox_SelectionChanged"
                              AutomationProperties.Name="Connection mode">
                        <ComboBoxItem Content="Auto" Tag="auto" IsSelected="True" />
                        <ComboBoxItem Content="USB" Tag="usb" />
                        <ComboBoxItem Content="Wi-Fi" Tag="wifi" />
                    </ComboBox>
                    <ComboBox x:Name="DeviceBox" Width="230" AutomationProperties.Name="iPhone device">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding DisplayDetails}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox x:Name="WifiAddressBox" Width="125" Text="" ToolTip="Wi-Fi iPhone address" AutomationProperties.Name="Wi-Fi iPhone address" />
                    <TextBox x:Name="WifiPortBox" Width="62" Text="49152" ToolTip="Wi-Fi remote pairing port" AutomationProperties.Name="Wi-Fi remote pairing port" />
                    <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" Background="{DynamicResource AccentBrush}"
                            AutomationProperties.Name="Connect iPhone" />
                    <Button Content="Setup" Click="SetupButton_Click" AutomationProperties.Name="Open phone setup" />
                    <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click" AutomationProperties.Name="Open settings" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SetupColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#08090A" CornerRadius="14" ClipToBounds="True" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    AutomationProperties.Name="iPhone screen viewer">
                <Grid>
                    <local:MpvHostControl x:Name="MpvHost" AutomationProperties.Name="Mirrored iPhone screen" />
                    <Border x:Name="EmptyOverlay" Background="#D90D0F11" Visibility="Visible"
                            AutomationProperties.Name="Viewer status">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="Connect an iPhone" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyMessage" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Use USB for first-time setup. Wi-Fi requires a saved CoreDevice pairing."
                                       AutomationProperties.Name="Viewer message" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="SetupPanel" Grid.Column="1" Width="340" Margin="10,0,0,0" Padding="16"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    CornerRadius="14" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock x:Name="PanelTitle" Text="Setup &amp; Settings" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <Button Content="Close" Click="CloseSetupButton_Click" DockPanel.Dock="Right" AutomationProperties.Name="Close phone setup" />
                        </DockPanel>

                        <!-- Tab switcher -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TabPhoneSetupBtn" Content="Phone Setup" Click="TabPhoneSetup_Click" Background="{DynamicResource AccentBrush}" Grid.Column="0" Margin="0,0,2,0" />
                            <Button x:Name="TabSettingsBtn" Content="Settings" Click="TabSettings_Click" Background="{DynamicResource SurfaceAltBrush}" Grid.Column="1" Margin="2,0,0,0" />
                        </Grid>

                        <!-- Phone Setup Tab View -->
                        <StackPanel x:Name="PhoneSetupSection" Visibility="Visible">
                            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Each action that changes the phone or pairing records asks for confirmation first. Passcodes stay on the iPhone." />
                            <Button Content="Refresh USB devices" Click="RefreshDevicesButton_Click" AutomationProperties.Name="Refresh USB devices" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Check setup" Click="CheckSetupButton_Click" AutomationProperties.Name="Check iPhone setup" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Trust this computer" Click="PairUsbButton_Click" AutomationProperties.Name="Trust this computer" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Reveal Developer Mode" Click="RevealDeveloperModeButton_Click" AutomationProperties.Name="Reveal Developer Mode" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Prepare developer image" Click="PrepareImageButton_Click" AutomationProperties.Name="Prepare developer image" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Pair Wi-Fi" Click="PairWifiButton_Click" AutomationProperties.Name="Pair iPhone for Wi-Fi" Margin="0,3" HorizontalAlignment="Stretch" />
                            <Button Content="Validate display service" Click="CheckDisplayButton_Click" AutomationProperties.Name="Validate display service" Margin="0,3" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="SetupStatusText" Margin="4,12,4,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                       AutomationProperties.Name="Setup status" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <!-- Settings & Preferences Tab View -->
                        <StackPanel x:Name="SettingsSection" Visibility="Collapsed">
                            <!-- Video & Performance -->
                            <TextBlock Text="VIDEO &amp; PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,6" />
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="HwDecodeBox" Content="Hardware acceleration (GPU decoding)" IsChecked="True"
                                              Checked="HwDecode_Changed" Unchecked="HwDecode_Changed" AutomationProperties.Name="Hardware acceleration" />
                                    <TextBlock Text="Uses GPU decoding for lowest latency. Disable if your display driver exhibits glitches."
                                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="20,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Window & Glass Backdrop -->
                            <TextBlock Text="WINDOW &amp; GLASS BACKDROP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,6" />
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="AlwaysOnTopBox" Content="Keep window always on top"
                                              Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed" AutomationProperties.Name="Always on top" />
                                    <TextBlock Text="Floating mirror mode while multitasking." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="20,2,0,8" />

                                    <TextBlock Text="Backdrop Effect (Windows 11):" FontSize="11" Margin="0,2,0,4" />
                                    <ComboBox x:Name="BackdropBox" SelectedIndex="0" SelectionChanged="BackdropBox_SelectionChanged" AutomationProperties.Name="Backdrop effect">
                                        <ComboBoxItem Content="Mica (Subtle desktop sheen)" Tag="Mica" />
                                        <ComboBoxItem Content="Acrylic (Frosted translucent blur)" Tag="Acrylic" />
                                        <ComboBoxItem Content="Mica Alt (Tabbed tint)" Tag="MicaAlt" />
                                        <ComboBoxItem Content="Solid (Classic opaque)" Tag="None" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Window Sizing Presets -->
                            <TextBlock Text="WINDOW SIZING PRESETS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,6" />
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Compact 75%" Click="Scale75_Click" Grid.Column="0" Margin="2,0" Padding="4,6" FontSize="11" AutomationProperties.Name="Scale 75%" />
                                    <Button Content="Actual 100%" Click="Scale100_Click" Grid.Column="1" Margin="2,0" Padding="4,6" FontSize="11" AutomationProperties.Name="Scale 100%" />
                                    <Button Content="Large 125%" Click="Scale125_Click" Grid.Column="2" Margin="2,0" Padding="4,6" FontSize="11" AutomationProperties.Name="Scale 125%" />
                                </Grid>
                            </Border>

                            <!-- Keyboard Shortcuts Reference -->
                            <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,6" />
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Ctrl + 1" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Width="70" />
                                        <TextBlock Text="Go to Home Screen" Foreground="{DynamicResource MutedTextBrush}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Ctrl + 2" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Width="70" />
                                        <TextBlock Text="Open App Switcher" Foreground="{DynamicResource MutedTextBrush}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Ctrl + 3" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Width="70" />
                                        <TextBlock Text="Open Spotlight Search" Foreground="{DynamicResource MutedTextBrush}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="Ctrl + V" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" DockPanel.Dock="Left" Width="70" />
                                        <TextBlock Text="Paste text to iPhone" Foreground="{DynamicResource MutedTextBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Padding="10" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="DeviceStatusText" Text="No active session" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                           AutomationProperties.Name="Device session status" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reconnect" Click="ReconnectButton_Click" AutomationProperties.Name="Reconnect iPhone" />
                    <Button Content="Disconnect" Click="DisconnectButton_Click" AutomationProperties.Name="Disconnect iPhone" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
